# Local SQLite
# DATABASE_URL="file:./dev.db"

# Hosted Supabase shared pooler (replace [YOUR-PASSWORD]; percent-encode special characters)
DATABASE_URL="postgresql://postgres.brnarfszzsvsdfgqwbny:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5"
# Required in production (Vercel). Generate with: openssl rand -base64 33
AUTH_SECRET="immigrome-dev-secret-change-in-production"
# Local only. Do NOT set this to localhost on Vercel — Auth.js uses the request host.
NEXTAUTH_URL="http://localhost:3000"

# Private bridge from Next.js server code to the Python API. Generate a
# separate long random value; never expose it through NEXT_PUBLIC_ variables.
INTERNAL_API_SECRET="replace-with-a-long-random-value"
# Local Python API. On Vercel this must be the public HTTPS URL of the
# deployed FastAPI service — never localhost or an empty value.
INTERNAL_API_URL="http://127.0.0.1:8000"
# Enable migrated API surfaces independently during canary rollout.
BACKEND_CAPABILITIES="automation"
# Separate machine-to-machine key used for scoped Hermes/MCP service JWTs.
# It must never equal AUTH_SECRET or INTERNAL_API_SECRET.
AUTOMATION_API_SECRET="replace-with-a-different-long-random-value"

# Private Hermes Runs API (Railway private networking in production).
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MCP_KEY=
HERMES_MCP_SCOPES="leads:read,leads:write,cases:read,tasks:create,documents:read,documents:request,messages:draft,messages:send,appointments:write,approvals:create"
AUTOMATION_ENABLED=false

# Telegram is the first external channel. Keep these server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Supabase API — paste from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://brnarfszzsvsdfgqwbny.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET="documents"

# OpenAI second-filter programme enrichment (off by default)
OPENAI_API_KEY=
OPENAI_PROGRAM_ENRICHMENT_ENABLED=true
OPENAI_PROGRAM_ENRICHMENT_MODEL=gpt-5.6-luna
OPENAI_PROGRAM_ENRICHMENT_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_PROGRAM_ENRICHMENT_ESCALATION_ENABLED=true
OPENAI_PROGRAM_ENRICHMENT_MAX_CANDIDATES=35
OPENAI_PROGRAM_ENRICHMENT_MAX_DOCUMENTS=5
OPENAI_PROGRAM_ENRICHMENT_MAX_HOPS=5
OPENAI_PROGRAM_ENRICHMENT_MAX_TOOL_CALLS=6
OPENAI_PROGRAM_ENRICHMENT_MAX_OUTPUT_TOKENS=
OPENAI_PROGRAM_ENRICHMENT_PROMPT_VERSION=v3
# One bounded official-domain web search after landing/catalogue/sitemap
# resolution fails. The result is still fetched and exact-page verified.
OPENAI_PROGRAMME_SEARCH_AGENT_ENABLED=true
OPENAI_PROGRAMME_SEARCH_AGENT_MODEL=gpt-5.6-luna
