# App
DATABASE_URL=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# OpenAI (programme enrichment)
OPENAI_API_KEY=
OPENAI_PROGRAM_ENRICHMENT_ENABLED=true
OPENAI_PROGRAM_ENRICHMENT_MODEL=gpt-5.6-luna
OPENAI_PROGRAM_ENRICHMENT_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_PROGRAM_ENRICHMENT_ESCALATION_ENABLED=true
OPENAI_PROGRAM_ENRICHMENT_MAX_CANDIDATES=35
OPENAI_PROGRAM_ENRICHMENT_MAX_DOCUMENTS=5
OPENAI_PROGRAM_ENRICHMENT_MAX_HOPS=5
OPENAI_PROGRAM_ENRICHMENT_MAX_TOOL_CALLS=6
OPENAI_PROGRAM_ENRICHMENT_MAX_OUTPUT_TOKENS=
OPENAI_PROGRAM_ENRICHMENT_PROMPT_VERSION=v3
OPENAI_PROGRAMME_SEARCH_AGENT_ENABLED=true
OPENAI_PROGRAMME_SEARCH_AGENT_MODEL=gpt-5.6-luna


HERMES_API_URL=
HERMES_API_KEY=

# Web only. Same value as MCP_BOOTSTRAP_KEY on the Hermes service (MCP Authorization).
# The worker does not read this. Hermes MCP URL lives in the Hermes config, not here.
MCP_BOOTSTRAP_KEY=

# Deprecated. Not read. Access is a server-side capability grant, not these keys.
# HERMES_MCP_KEY=
# HERMES_MCP_SCOPES=
# HERMES_MCP_URL=

# Nous hermes-agent process (Hermes service, not the worker).
# https://github.com/NousResearch/hermes-agent
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=
API_SERVER_KEY=
DEEPSEEK_API_KEY=


# Kill-switch: hard floor. Effective automation also needs DB global_enabled=true
# (toggle at /admin/automation). Missing DB row = off.
AUTOMATION_ENABLED=

# Channels (Phase 1–2; used by web webhook + worker handlers)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=

GOOGLE_SERVICE_ACCOUNT_JSON=

# Worker (optional)
# WORKER_ID=
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_CLAIM_LIMIT=25
