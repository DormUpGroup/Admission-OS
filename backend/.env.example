# Reuse the existing root .env for DATABASE_URL in local development.
# Required once Next.js begins calling protected FastAPI endpoints.
INTERNAL_API_SECRET="generate-a-long-random-value-before-production"
AUTOMATION_API_SECRET="generate-a-separate-long-random-value"

# Private Hermes Runs API.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MCP_KEY=
HERMES_MCP_SCOPES="leads:read,leads:write,cases:read,tasks:create,documents:read,documents:request,messages:draft,messages:send,appointments:write,approvals:create"
AUTOMATION_ENABLED=false

# Telegram Bot API ingress/delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar service account. Share GOOGLE_CALENDAR_ID with client_email.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Required when background workers are introduced.
REDIS_URL="redis://localhost:6379/0"
