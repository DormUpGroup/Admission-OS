generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curatedStudents       Student[]           @relation("CuratorStudents")
  acceptedStudents      Student[]           @relation("StudentAcceptedBy")
  studentProfile        Student?            @relation("StudentUser")
  assignedTasks         Task[]              @relation("TaskAssignee")
  reviewedDocs          Document[]          @relation("DocumentReviewer")
  activities            Activity[]
  notifications         InAppNotification[]
  assignedConversations Conversation[]      @relation("ConversationAssignee")
  assignedAppointments  Appointment[]       @relation("AppointmentAssignee")
  assignedLeads         Lead[]              @relation("LeadAssignee")
}

model Student {
  id                        String    @id @default(cuid())
  userId                    String?   @unique
  firstName                 String
  lastName                  String
  email                     String    @unique
  phone                     String?
  country                   String?
  nationality               String?
  studyLevel                String    @default("BACHELOR")
  intake                    String
  targetField               String?
  preferredLanguage         String?
  preferredCities           String?
  questionnaireAt           DateTime?
  questionnairePersonalJson String?
  questionnaireProgramsJson String?
  questionnaireProgramsAt   DateTime?
  status                    String    @default("ACTIVE")
  journeyStage              String    @default("PROFILE")
  curatorId                 String?
  riskLevel                 String    @default("NONE")
  nextActionJson            String?
  accompanimentStatus       String    @default("NONE")
  acceptedAt                DateTime?
  acceptedById              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user           User?                  @relation("StudentUser", fields: [userId], references: [id])
  curator        User?                  @relation("CuratorStudents", fields: [curatorId], references: [id])
  acceptedBy     User?                  @relation("StudentAcceptedBy", fields: [acceptedById], references: [id])
  applications   Application[]
  documents      Document[]
  tasks          Task[]
  deadlines      Deadline[]
  activities     Activity[]
  programMatches ProgramMatch[]
  shortlistItems StudentShortlistItem[]
  notifications     InAppNotification[]
  conversations     Conversation[]
  appointments      Appointment[]
  channelIdentities ChannelIdentity[]
  convertedFromLead Lead?                 @relation("ConvertedLead")

  @@index([curatorId])
  @@index([acceptedById])
}

model IntakeCohort {
  id        String   @id @default(cuid())
  intake    String   @unique
  seatLimit Int?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id                     String           @id @default(cuid())
  name                   String
  slug                   String           @unique
  city                   String?
  region                 String?
  country                String           @default("IT")
  publicPrivate          String?
  website                String?
  universitalyExternalId String?
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  programs               Program[]
  sourceDocuments        SourceDocument[]
}

model Program {
  id                     String   @id @default(cuid())
  universityId           String
  name                   String
  slug                   String
  titleOfficial          String?
  titleEnglish           String?
  degreeLevel            String   @default("BACHELOR")
  degreeClass            String?
  field                  String?
  fieldTagsJson          String?
  language               String?
  teachingLanguagesJson  String?
  deliveryMode           String?
  durationYears          Int?
  ects                   Int?
  campusCity             String?
  // Proven campuses JSON: [{name?, city, sourceDocumentId, sourceUrl, quote}]
  campusesJson           String?
  region                 String?
  officialUrl            String?
  universitalyUrl        String?
  universitalyExternalId String?
  aliasesJson            String?
  active                 Boolean  @default(true)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  university      University            @relation(fields: [universityId], references: [id])
  applications    Application[]
  templates       ApplicationTemplate[]
  academicYears   ProgramAcademicYear[]
  facts           ProgramFact[]
  sourceDocuments SourceDocument[]

  @@unique([universityId, slug])
}

model Application {
  id                         String    @id @default(cuid())
  studentId                  String
  programId                  String
  programAcademicYearId      String?
  status                     String    @default("SELECTED")
  intake                     String
  applicationRound           String?
  admissionType              String?
  requiredExam               String?
  requiredEnglish            String?
  applicationFee             String?
  hardDeadline               DateTime?
  targetSubmissionDate       DateTime?
  submittedAt                DateTime?
  applicationIdExternal      String?
  submissionConfirmationNote String?
  applicationFeePaid         Boolean   @default(false)
  readinessPercent           Int       @default(0)
  riskLevel                  String    @default("NONE")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program             Program              @relation(fields: [programId], references: [id])
  programAcademicYear ProgramAcademicYear? @relation(fields: [programAcademicYearId], references: [id])
  requirements        Requirement[]
  tasks               Task[]
  deadlines           Deadline[]
  activities          Activity[]

  @@index([programAcademicYearId])
  @@index([studentId])
  @@index([programId])
}

model Requirement {
  id                String    @id @default(cuid())
  applicationId     String
  name              String
  type              String
  status            String    @default("MISSING")
  isCritical        Boolean   @default(false)
  notes             String?
  relatedDocumentId String?
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  relatedDocument Document?   @relation(fields: [relatedDocumentId], references: [id])
  deadlines       Deadline[]

  @@index([applicationId])
  @@index([relatedDocumentId])
}

model Document {
  id              String    @id @default(cuid())
  studentId       String
  name            String
  category        String    @default("OTHER")
  status          String    @default("MISSING")
  storagePath     String?
  fileUrl         String?
  version         Int       @default(1)
  uploadedAt      DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  expiryDate      DateTime?
  notesInternal   String?
  studentFeedback String?
  requestedAt     DateTime?
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  requirements Requirement[]
  tasks        Task[]

  @@index([studentId])
  @@index([reviewedById])
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("TODO")
  priority        String    @default("MEDIUM")
  assigneeId      String?
  studentId       String
  applicationId   String?
  documentId      String?
  dueDate         DateTime?
  isStudentFacing Boolean   @default(false)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])
  document    Document?    @relation(fields: [documentId], references: [id])
  deadlines   Deadline[]

  @@index([assigneeId])
  @@index([studentId])
  @@index([applicationId])
  @@index([documentId])
}

model Deadline {
  id             String   @id @default(cuid())
  title          String
  date           DateTime
  type           String   @default("OTHER")
  studentId      String
  applicationId  String?
  requirementId  String?
  taskId         String?
  isHardDeadline Boolean  @default(false)
  isInternal     Boolean  @default(false)
  riskWeight     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id])

  @@index([studentId])
  @@index([applicationId])
  @@index([requirementId])
  @@index([taskId])
}

model Activity {
  id            String   @id @default(cuid())
  type          String
  studentId     String
  applicationId String?
  userId        String?
  metadata      String?
  createdAt     DateTime @default(now())

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([studentId])
  @@index([applicationId])
  @@index([userId])
}

model ApplicationTemplate {
  id        String   @id @default(cuid())
  name      String
  programId String?
  intake    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program?                  @relation(fields: [programId], references: [id])
  items   ApplicationTemplateItem[]

  @@index([programId])
}

model ApplicationTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  name       String
  type       String
  isCritical Boolean @default(false)

  template ApplicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ProgramAcademicYear {
  id                      String    @id @default(cuid())
  programId               String
  academicYear            String
  status                  String    @default("ACTIVE")
  applicationStatus       String    @default("UNKNOWN")
  dataConfidence          String    @default("LOW")
  indicativeFromYear      String?
  // OPEN | CLOSED | UNKNOWN
  accessMode              String    @default("UNKNOWN")
  // Last successful deep HTML dossier enrich (shared across students)
  dossierEnrichedAt       DateTime?
  // Last monitoring poll (even when page unchanged) — cadence 7/14 days
  lastMonitoringCheckedAt DateTime?
  verifiedAt              DateTime?
  lastUpdatedAt           DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  program         Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  cycles          AdmissionCycle[]
  requirements    AdmissionRequirement[]
  tuition         TuitionInfo?
  matches         ProgramMatch[]
  shortlistItems  StudentShortlistItem[]
  facts           ProgramFact[]
  sourceDocuments SourceDocument[]
  enrichmentRuns  ProgramEnrichmentRun[]
  applications    Application[]

  @@unique([programId, academicYear])
}

model AdmissionCycle {
  id                       String    @id @default(cuid())
  programAcademicYearId    String
  roundName                String    @default("Round 1")
  applicationOpen          DateTime?
  applicationDeadline      DateTime?
  rankingDate              DateTime?
  enrollmentDeadline       DateTime?
  startDate                DateTime?
  totalSeats               Int?
  euSeats                  Int?
  nonEuSeats               Int?
  nonEuResidentAbroadSeats Int?
  applicantCategory        String?
  notes                    String?

  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id], onDelete: Cascade)

  @@index([programAcademicYearId])
}

model AdmissionRequirement {
  id                    String  @id @default(cuid())
  programAcademicYearId String
  type                  String
  required              Boolean @default(true)
  operator              String?
  valueJson             String?
  description           String?
  sourceFactId          String?
  hardExclusion         Boolean @default(false)

  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id], onDelete: Cascade)
  sourceFact          ProgramFact?        @relation(fields: [sourceFactId], references: [id])

  @@index([programAcademicYearId])
  @@index([sourceFactId])
}

model TuitionInfo {
  id                    String  @id @default(cuid())
  programAcademicYearId String  @unique
  minTuition            Int?
  maxTuition            Int?
  fixedTuition          Int?
  currency              String  @default("EUR")
  incomeBased           Boolean @default(false)
  internationalFlatTax  Boolean @default(false)
  notes                 String?
  sourceFactId          String?

  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id], onDelete: Cascade)
}

model SourceDocument {
  id                    String    @id @default(cuid())
  sourceType            String
  sourceAuthority       String?
  url                   String
  title                 String?
  academicYear          String?
  universityId          String?
  programId             String?
  programAcademicYearId String?
  contentType           String    @default("html")
  retrievedAt           DateTime  @default(now())
  publishedAt           DateTime?
  contentHash           String
  rawStoragePath        String?
  rawText               String?
  parserVersion         String    @default("v1")
  status                String    @default("FETCHED")
  extractionQuality     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  university          University?             @relation(fields: [universityId], references: [id])
  program             Program?                @relation(fields: [programId], references: [id])
  programAcademicYear ProgramAcademicYear?    @relation(fields: [programAcademicYearId], references: [id])
  facts               ProgramFact[]
  changeEvents        ProgramChangeEvent[]
  sections            SourceDocumentSection[]

  @@index([contentHash])
  @@index([url])
  @@index([universityId])
  @@index([programId])
  @@index([programAcademicYearId])
}

// Deterministic official-document sections for retrieval.
// Embeddings may be added later only as a second retrieval stage after hard
// metadata filtering. They are never a source of truth for facts or eligibility.
model SourceDocumentSection {
  id               String   @id @default(cuid())
  sourceDocumentId String
  heading          String   @default("")
  sectionType      String
  position         Int
  text             String
  contentHash      String
  // Extensible JSON: applicantCategoryHints, academicYearHint, sourceAuthority,
  // parentHeading, splitIndex, htmlKind. Reserved for a future embedding id —
  // not used as evidence.
  metadataJson     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId, sectionType])
  @@index([sourceDocumentId, position])
  @@index([contentHash])
}

model ProgramFact {
  id                     String    @id @default(cuid())
  programId              String
  programAcademicYearId  String?
  field                  String
  normalizedValueJson    String
  rawValue               String?
  evidenceQuote          String?
  applicantCategoryScope String?
  freshness              String?
  extractionMetadataJson String?
  // AI | OFFICIAL_FALLBACK | MANUAL_VERIFIED | LEGACY_CANDIDATE | DISCOVERY
  origin                 String    @default("LEGACY_CANDIDATE")
  // Stable discriminator for collection facts (quota category, round, campus, exam).
  dimensionKey           String?
  // ELIGIBLE | LEGACY_CANDIDATE | AMBIGUOUS | CONFLICT
  decisionStatus         String    @default("LEGACY_CANDIDATE")
  evidenceValidatedAt    DateTime?
  resolverVersion        String?
  sourceDocumentId       String?
  sourceUrl              String?
  sourceType             String
  academicYear           String?
  retrievedAt            DateTime  @default(now())
  confidence             String    @default("MEDIUM")
  extractionMethod       String    @default("MANUAL")
  verificationStatus     String    @default("UNVERIFIED")
  verifiedById           String?
  verifiedAt             DateTime?
  verificationNote       String?
  superseded             Boolean   @default(false)

  program             Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  programAcademicYear ProgramAcademicYear?   @relation(fields: [programAcademicYearId], references: [id])
  sourceDocument      SourceDocument?        @relation(fields: [sourceDocumentId], references: [id])
  requirements        AdmissionRequirement[]

  @@index([programAcademicYearId, field, academicYear, applicantCategoryScope])
  @@index([programAcademicYearId, field, origin, decisionStatus, superseded])
  @@index([programId])
  @@index([sourceDocumentId])
}

model ProgramEnrichmentRun {
  id                    String    @id @default(cuid())
  programAcademicYearId String
  applicantCategory     String
  status                String
  model                 String?
  promptVersion         String
  sourceFingerprint     String
  sourceDocumentIdsJson String?
  resolvedFactIdsJson   String?
  origin                String    @default("AI")
  academicYear          String?
  resolverVersion       String?
  toolCallCount         Int       @default(0)
  inputTokens           Int?
  outputTokens          Int?
  quoteRejectCount      Int       @default(0)
  reusedFromRunId       String?
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  error                 String?

  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id], onDelete: Cascade)

  @@index([programAcademicYearId, applicantCategory, sourceFingerprint, promptVersion])
  @@index([status])
}

model ProgramMatch {
  id                      String    @id @default(cuid())
  studentId               String
  programAcademicYearId   String
  eligibilityStatus       String
  fitScore                Int
  scoreBreakdownJson      String?
  requirementsSummaryJson String?
  reasonsJson             String?
  risksJson               String?
  missingInformationJson  String?
  discoveryMetaJson       String?
  dataConfidence          String    @default("LOW")
  generatedAt             DateTime  @default(now())
  matchingEngineVersion   String
  curatorStatus           String    @default("AUTO_MATCHED")
  curatorNotes            String?
  reviewedById            String?
  reviewedAt              DateTime?
  monitoringSelected      Boolean   @default(false)
  monitoringSelectedAt    DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, programAcademicYearId])
  @@index([monitoringSelected])
}

model StudentShortlistItem {
  id                    String   @id @default(cuid())
  studentId             String
  programAcademicYearId String
  programMatchId        String?
  curatorNote           String?
  studentStatus         String   @default("PENDING")
  visibleToStudent      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programAcademicYear ProgramAcademicYear @relation(fields: [programAcademicYearId], references: [id])

  @@unique([studentId, programAcademicYearId])
}

model ScholarshipProgram {
  id           String            @id @default(cuid())
  region       String
  authority    String
  name         String
  academicYear String
  sourceUrl    String?
  verifiedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  rules        ScholarshipRule[]

  @@unique([authority, academicYear, name])
}

model ScholarshipRule {
  id                    String    @id @default(cuid())
  scholarshipProgramId  String
  iseeThreshold         Int?
  ispeThreshold         Int?
  residencyNotes        String?
  internationalDocsJson String?
  deadline              DateTime?
  amountMin             Int?
  amountMax             Int?
  notes                 String?
  sourceUrl             String?

  scholarshipProgram ScholarshipProgram @relation(fields: [scholarshipProgramId], references: [id], onDelete: Cascade)

  @@index([scholarshipProgramId])
}

model ProgramChangeEvent {
  id                    String   @id @default(cuid())
  sourceDocumentId      String?
  programId             String?
  programAcademicYearId String?
  field                 String
  oldValue              String?
  newValue              String?
  severity              String   @default("INFO")
  alerted               Boolean  @default(false)
  createdAt             DateTime @default(now())

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id])

  @@index([sourceDocumentId])
}

model InAppNotification {
  id           String    @id @default(cuid())
  userId       String
  studentId    String?
  type         String
  title        String
  body         String
  metadataJson String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([studentId])
}

// --- Outbox / channels (Phase 0–1) ---

model Lead {
  id                 String    @id @default(cuid())
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  status             String    @default("NEW")
  source             String    @default("TELEGRAM")
  locale             String?
  consentStatus      String    @default("UNKNOWN")
  consentAt          DateTime?
  qualificationJson  Json?
  assignedCuratorId  String?
  convertedStudentId String?   @unique
  convertedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedCurator   User?             @relation("LeadAssignee", fields: [assignedCuratorId], references: [id], onDelete: SetNull)
  convertedStudent  Student?          @relation("ConvertedLead", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  channelIdentities ChannelIdentity[]
  conversations     Conversation[]
  appointments      Appointment[]

  @@index([status, createdAt])
  @@index([assignedCuratorId, status])
  @@index([email])
  @@index([phone])
}

model ChannelIdentity {
  id           String    @id @default(cuid())
  channel      String
  externalId   String
  username     String?
  displayName  String?
  leadId       String?
  studentId    String?
  verifiedAt   DateTime?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([leadId])
  @@index([studentId])
}

model InboxEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  payloadHash     String
  payloadJson     Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

model Conversation {
  id                    String    @id @default(cuid())
  channel               String
  status                String    @default("OPEN")
  leadId                String?
  studentId             String?
  assignedCuratorId     String?
  hermesSessionId       String?
  automationPausedAt    DateTime?
  automationPauseReason String?
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  /// Watermark: staff has seen inbound up to this time (Immigrome UI open / reply).
  staffLastReadAt       DateTime?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lead            Lead?                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student         Student?              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedCurator User?                 @relation("ConversationAssignee", fields: [assignedCuratorId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]
  appointments    Appointment[]

  @@index([leadId, status])
  @@index([studentId, status])
  @@index([assignedCuratorId, status])
  @@index([channel, status])
  @@index([channel, status, lastInboundAt])
}

model ConversationMessage {
  id                String    @id @default(cuid())
  conversationId    String
  clientRequestId   String?   @unique
  legacyActivityId  String?   @unique
  providerMessageId String?
  direction         String
  senderType        String
  senderUserId      String?
  body              String?
  attachmentsJson   Json?
  deliveryStatus    String    @default("RECEIVED")
  policyStatus      String    @default("PENDING")
  replyToMessageId  String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversation     Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo          ConversationMessage?  @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies          ConversationMessage[] @relation("MessageReplies")
  deliveryAttempts DeliveryAttempt[]

  @@unique([conversationId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([deliveryStatus, createdAt])
}

model Appointment {
  id                       String    @id @default(cuid())
  clientRequestId          String    @unique
  leadId                   String?
  studentId                String?
  conversationId           String?
  assignedCuratorId        String?
  title                    String
  startsAt                 DateTime
  endsAt                   DateTime
  timezone                 String    @default("Europe/Rome")
  status                   String    @default("PENDING")
  googleEventId            String?   @unique
  participantsJson         Json?
  version                  Int       @default(1)
  pendingStartsAt          DateTime?
  pendingEndsAt            DateTime?
  confirmationToken        String?   @unique
  confirmationRequestedAt  DateTime?
  lastClientNudgeAt        DateTime?
  curatorNudgeSentAt       DateTime?
  /// Client confirmed or picked a time. Cleared when staff opens the appointment.
  clientChangeUnseen       Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student         Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedCurator User?         @relation("AppointmentAssignee", fields: [assignedCuratorId], references: [id], onDelete: SetNull)

  @@index([assignedCuratorId, startsAt])
  @@index([leadId, startsAt])
  @@index([studentId, startsAt])
  @@index([status, startsAt])
  @@index([clientChangeUnseen])
}

model AutomationSetting {
  key         String   @id
  valueJson   Json
  description String?
  updatedAt   DateTime @updatedAt
}

model OutboxEvent {
  id             String    @id @default(cuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  eventVersion   Int       @default(1)
  payloadJson    Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  nextAttemptAt  DateTime  @default(now())
  lockedBy       String?
  lockedAt       DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveryAttempts DeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([lockedAt])
  @@index([status, leaseExpiresAt])
}

model DeliveryAttempt {
  id                 String    @id @default(cuid())
  messageId          String?
  outboxEventId      String?
  provider           String
  attempt            Int
  status             String
  providerResponseId String?
  errorCode          String?
  errorMessage       String?
  nextRetryAt        DateTime?
  createdAt          DateTime  @default(now())

  message     ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  outboxEvent OutboxEvent?         @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@unique([provider, messageId, attempt])
  @@index([outboxEventId])
  @@index([status, nextRetryAt])
}
